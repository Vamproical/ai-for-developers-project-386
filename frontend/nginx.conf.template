map $http_accept $spa_request {
    default 0;
    "~*text/html" 1;
}

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Public API
    location = /event-types { proxy_pass http://backend:${PORT}; }
    location = /slots { proxy_pass http://backend:${PORT}; }
    location = /bookings { proxy_pass http://backend:${PORT}; }

    # Admin API (no SPA route collision)
    location = /admin/slots { proxy_pass http://backend:${PORT}; }
    location ~ ^/admin/event-types/[^/]+$ { proxy_pass http://backend:${PORT}; }
    location ~ ^/admin/bookings/[^/]+/cancel$ { proxy_pass http://backend:${PORT}; }

    # Admin API paths that are also SPA routes — browser navigation (Accept: text/html)
    # gets the SPA shell, JSON API calls (fetch) are proxied to the backend.
    location ~ ^/admin/(event-types|schedules|bookings)$ {
        if ($spa_request = 1) {
            rewrite ^ /index.html last;
        }
        proxy_pass http://backend:${PORT};
    }

    # Static assets (hashed filenames)
    location /assets/ { try_files $uri =404; }

    # SPA fallback (history routing: /, /admin, /admin/settings, deep links)
    location / { try_files $uri $uri/ /index.html; }
}
